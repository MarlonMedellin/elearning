---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CircularsTable from "../components/CircularsTable.astro";
import SocialShare from "../components/ui/SocialShare.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import diaMaestro1 from "../assets/dia-maestro-1.png";
import diaMaestro2 from "../assets/dia-maestro-2.png";
---

<MainLayout
  title="Horario especial viernes 22 de mayo"
  description="Aviso institucional sobre jornada especial y ajuste de horario para el viernes 22 de mayo por proceso de formación docente."
  keywords="Horario especial, aviso institucional, IE Capilla del Rosario, formación docente"
  image="/assets/escudo.jpg"
>
  <Navbar />
  <PageHeader title="Comunicaciones" />

  <main class="py-20">
    <section class="container mx-auto px-4 lg:px-8">

      <!-- Publicación: Horario Especial -->
      <article class="bg-white rounded-3xl shadow-sm hover:shadow-md transition-shadow border border-gray-200 p-6 md:p-10 mb-16 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-8 opacity-[0.03] pointer-events-none group-hover:scale-110 group-hover:rotate-3 transition-transform duration-700">
          <Icon name="lucide:clock-4" class="w-64 h-64 text-primary" />
        </div>

        <div class="relative z-10 max-w-4xl mx-auto">
          <!-- Badges & Fecha -->
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-100 text-blue-800 rounded-full text-sm font-bold tracking-wide uppercase shadow-sm">
              <Icon name="lucide:bell-ring" class="w-4 h-4" /> Aviso Institucional
            </div>
            <time datetime="2026-05-22" class="inline-flex items-center gap-2 px-4 py-1.5 bg-gray-100 text-gray-600 rounded-full text-sm font-bold tracking-wide uppercase shadow-sm">
              <Icon name="lucide:calendar-clock" class="w-4 h-4" /> 22 de mayo, 2026
            </time>
          </div>

          <!-- Cabecera -->
          <header class="mb-10">
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-brand-dark mb-4 tracking-tight">
              Horario especial viernes 22 de mayo
            </h1>
            <p class="text-lg md:text-xl text-gray-600 leading-relaxed font-medium">
              Informamos a toda la comunidad educativa que el viernes 22 de mayo se trabajará en horario especial.
            </p>
          </header>

          <!-- Detalles del horario -->
          <div class="bg-gray-50 p-6 md:p-8 rounded-2xl border border-gray-100 mb-10 space-y-6">
            <ul class="space-y-6">
              <li class="flex items-start gap-4">
                <div class="text-2xl mt-1">📝</div>
                <div>
                  <strong class="block text-brand-dark text-lg mb-1">Motivo</strong>
                  <span class="text-gray-700 text-lg">Proceso de formación docente.</span>
                </div>
              </li>
              
              <li class="flex items-start gap-4">
                <div class="text-2xl mt-1">🕒</div>
                <div>
                  <span class="text-gray-700 text-lg">Se dictarán las 6 horas de clase en versión más corta.</span>
                </div>
              </li>
              
              <li class="flex items-start gap-4">
                <div class="text-2xl mt-1">🌞</div>
                <div>
                  <strong class="block text-brand-dark text-lg mb-1">Jornada de la Mañana</strong>
                  <span class="text-gray-700 text-lg">Los estudiantes saldrán a las 11:00 a. m.</span>
                </div>
              </li>
              
              <li class="flex items-start gap-4">
                <div class="text-2xl mt-1">🌤️</div>
                <div>
                  <strong class="block text-brand-dark text-lg mb-1">Jornada de la Tarde</strong>
                  <span class="text-gray-700 text-lg">Los estudiantes ingresarán a la 1:00 p. m.</span>
                </div>
              </li>
            </ul>
          </div>

          <!-- Cierre Institucional -->
          <div class="bg-primary/5 p-6 rounded-2xl border border-primary/10 mb-10">
            <p class="text-lg text-brand-dark font-medium italic text-center sm:text-left">
              Agradecemos la atención y el apoyo de las familias frente a este ajuste institucional.
            </p>
          </div>

          <!-- Enlaces Institucionales -->
          <div class="mb-10">
            <h2 class="text-xl font-bold text-brand-dark mb-4">Canales oficiales</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <a href="https://tinyurl.com/canalcapilla" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-white hover:bg-gray-50 border border-gray-200 p-4 rounded-xl transition-colors shadow-sm hover:shadow group">
                <div class="bg-primary/10 p-2 rounded-lg text-primary group-hover:scale-110 transition-transform">
                  <Icon name="lucide:message-circle" class="w-6 h-6" />
                </div>
                <div class="flex-1 overflow-hidden">
                  <strong class="block text-brand-dark text-sm">Canal Institucional</strong>
                  <span class="text-primary text-xs truncate block">tinyurl.com/canalcapilla</span>
                </div>
              </a>
              
              <a href="https://lacapilla.edu.co/circulares/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 bg-white hover:bg-gray-50 border border-gray-200 p-4 rounded-xl transition-colors shadow-sm hover:shadow group">
                <div class="bg-primary/10 p-2 rounded-lg text-primary group-hover:scale-110 transition-transform">
                  <Icon name="lucide:link" class="w-6 h-6" />
                </div>
                <div class="flex-1 overflow-hidden">
                  <strong class="block text-brand-dark text-sm">Comunicaciones</strong>
                  <span class="text-primary text-xs truncate block">lacapilla.edu.co/circulares/</span>
                </div>
              </a>
            </div>
          </div>

          <!-- Compartir -->
          <div class="mt-10 flex justify-center border-t border-gray-100 pt-8">
            <SocialShare
              title="Horario especial viernes 22 de mayo"
              text="Informamos a toda la comunidad educativa que el viernes 22 de mayo se trabajará en horario especial."
              waIcon="lucide:bell-ring"
            />
          </div>
        </div>
      </article>

      <!-- Publicación: Día del Maestro -->
      <article class="bg-gradient-to-br from-brand-light/10 to-white rounded-3xl shadow-sm hover:shadow-md transition-shadow border border-gray-200 p-6 md:p-12 mb-16 relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-8 opacity-[0.03] pointer-events-none group-hover:scale-110 group-hover:rotate-3 transition-transform duration-700">
          <Icon name="lucide:heart-handshake" class="w-64 h-64 text-primary" />
        </div>

        <div class="relative z-10 max-w-5xl mx-auto">
          <!-- Badges & Fecha -->
          <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary/10 text-primary rounded-full text-sm font-bold tracking-wide uppercase shadow-sm">
              <Icon name="lucide:award" class="w-4 h-4" /> Conmemoración Institucional
            </div>
            <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gray-100 text-gray-600 rounded-full text-sm font-bold tracking-wide uppercase shadow-sm">
              <Icon name="lucide:calendar-heart" class="w-4 h-4" /> 15 de mayo, 2026
            </div>
          </div>

          <!-- Cabecera -->
          <header class="text-center mb-14">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-brand-dark mb-6 tracking-tight">
              Día del Maestro
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed font-medium">
              Homenaje institucional a nuestros maestros, reconociendo la huella profunda que dejan en la vida, los sueños y el camino de sus estudiantes.
            </p>
          </header>

          <!-- Poema Central (Contenedor Editorial) -->
          <div class="max-w-3xl mx-auto relative mb-16">
            <Icon name="lucide:quote" class="absolute -top-6 -left-6 w-16 h-16 text-primary/10 rotate-180 hidden sm:block" />
            <Icon name="lucide:quote" class="absolute -bottom-6 -right-6 w-16 h-16 text-primary/10 hidden sm:block" />
            
            <div class="bg-gray-50/80 p-8 md:p-14 rounded-3xl shadow-inner border border-gray-100 relative z-10">
              <blockquote class="text-xl md:text-2xl text-brand-dark font-serif italic leading-loose text-center">
                <p class="mb-6">
                  <span class="block">“Enseñarás a volar,</span>
                  <span class="block">pero no volarán tu vuelo.</span>
                </p>
                <p class="mb-6">
                  <span class="block">Enseñarás a soñar,</span>
                  <span class="block">pero no soltarán tu sueño.</span>
                </p>
                <p class="mb-8">
                  <span class="block">Enseñarás a vivir,</span>
                  <span class="block">pero no vivirán tu vida.</span>
                </p>
                <p class="text-lg md:text-xl">
                  <span class="block">Sin embargo…</span>
                  <span class="block">en cada vuelo,</span>
                  <span class="block">en cada sueño,</span>
                  <span class="block">perdurará siempre la huella</span>
                  <span class="block font-bold">del camino enseñado.”</span>
                </p>
              </blockquote>
              <footer class="mt-10 text-center">
                <div class="w-12 h-1 bg-primary/30 mx-auto mb-4 rounded-full"></div>
                <cite class="text-sm font-bold text-gray-400 uppercase tracking-widest not-italic">
                  Madre Teresa de Calcuta
                </cite>
              </footer>
            </div>
          </div>

          <!-- Galería de Imágenes -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
            <div class="rounded-3xl overflow-hidden shadow-md border border-gray-100 group bg-gray-50">
              <Image 
                src={diaMaestro1} 
                alt="Conmemoración Día del Maestro - Celebración Institucional" 
                class="w-full h-[350px] md:h-[450px] object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
            <div class="rounded-3xl overflow-hidden shadow-md border border-gray-100 group bg-gray-50">
              <Image 
                src={diaMaestro2} 
                alt="Homenaje a nuestros docentes - Día del Maestro" 
                class="w-full h-[350px] md:h-[450px] object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
          </div>

          <!-- Cierre Institucional -->
          <div class="text-center max-w-3xl mx-auto bg-primary/5 p-8 md:p-10 rounded-3xl border border-primary/10">
            <p class="text-lg md:text-xl text-brand-dark leading-relaxed font-medium">
              Hoy honramos a quienes enseñan con conocimiento, paciencia y ejemplo. En cada aprendizaje, en cada sueño acompañado y en cada camino orientado, permanece la huella invaluable de nuestros maestros.
            </p>
          </div>

          <!-- Compartir -->
          <div class="mt-12 flex justify-center border-t border-gray-100 pt-10">
            <SocialShare
              title="Día del Maestro | IE Capilla del Rosario MDE"
              text="Homenaje institucional a nuestros docentes. En cada vuelo, en cada sueño, perdurará siempre la huella del camino enseñado."
              waIcon="lucide:heart"
            />
          </div>
        </div>
      </article>

      <!-- Publicación: Gran Escuela para la Familia -->
      <article
        class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-10 mb-16 relative overflow-hidden group"
      >
        <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:scale-110 transition-transform duration-500">
          <Icon name="lucide:home" class="w-32 h-32 text-primary" />
        </div>

        <div class="relative z-10">
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-semibold"
            >
              <Icon name="lucide:users" class="w-4 h-4" /> Escuela de Familias
            </div>
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-semibold"
            >
              <Icon name="lucide:calendar" class="w-4 h-4" /> 14 de mayo, 2026
            </div>
          </div>

          <div class="flex flex-col lg:flex-row gap-8 mb-10">
            <div class="flex-1">
              <header class="mb-6">
                <h2 class="text-2xl md:text-4xl font-bold text-brand-dark mb-4 leading-tight">
                  Gran Escuela para la Familia
                </h2>
                <p class="text-gray-600 text-xl font-medium leading-relaxed italic">
                  “¿Ya conoces la Gran Escuela para la Familia?”
                </p>
              </header>

              <div class="prose prose-lg max-w-none text-gray-700 mb-8">
                <p>
                  Este <strong>23 de mayo</strong>, a las 10:00 a.m., realizaremos este espacio en el que podemos aprender herramientas para fortalecer la crianza, el bienestar y las relaciones en casa con quienes más amamos.
                </p>
                <p class="font-bold text-primary">
                  💬 Encuentros cercanos, conversaciones reales y aprendizajes que sí sirven en la vida diaria.
                </p>
              </div>

              <!-- Bloque de Detalles -->
              <div class="bg-brand-light/10 border border-brand-light/30 rounded-2xl p-6 mb-8">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="flex items-start gap-3">
                    <Icon name="lucide:calendar-check" class="w-5 h-5 text-primary shrink-0 mt-1" />
                    <div>
                      <span class="block text-xs font-bold text-gray-400 uppercase">Fecha</span>
                      <span class="text-sm font-bold text-brand-dark">Sábado 23 de mayo, 2026</span>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <Icon name="lucide:clock" class="w-5 h-5 text-primary shrink-0 mt-1" />
                    <div>
                      <span class="block text-xs font-bold text-gray-400 uppercase">Hora</span>
                      <span class="text-sm font-bold text-brand-dark">10:00 a.m.</span>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <Icon name="lucide:map-pin" class="w-5 h-5 text-primary shrink-0 mt-1" />
                    <div>
                      <span class="block text-xs font-bold text-gray-400 uppercase">Lugar</span>
                      <span class="text-sm font-bold text-brand-dark">En tu barrio o corregimiento</span>
                    </div>
                  </div>
                  <div class="flex items-start gap-3">
                    <Icon name="lucide:sparkles" class="w-5 h-5 text-primary shrink-0 mt-1" />
                    <div>
                      <span class="block text-xs font-bold text-gray-400 uppercase">Propósito</span>
                      <span class="text-sm font-bold text-brand-dark">Tejiendo Hogares</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="lg:w-80 shrink-0">
              <div class="bg-white p-2 rounded-2xl border border-gray-200 shadow-sm rotate-1 hover:rotate-0 transition-transform duration-500">
                <a href="/img/gallery/gran-escuela-para-la-familia.jpeg" target="_blank" class="block group cursor-zoom-in" title="Ver imagen completa">
                  <img
                    src="/img/gallery/gran-escuela-para-la-familia.jpeg"
                    alt="Poster Gran Escuela para la Familia 2026"
                    class="w-full h-auto rounded-xl object-cover shadow-inner"
                  />
                  <div class="mt-2 flex items-center justify-center gap-1.5 text-[10px] text-gray-400 font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                    <Icon name="lucide:maximize-2" class="w-3 h-3" /> Ampliar imagen
                  </div>
                </a>
              </div>
            </div>
          </div>

          <!-- Temáticas y Lugares -->
          <div class="mb-10 p-6 bg-gray-50 rounded-2xl border border-gray-100">
            <h3 class="text-lg font-bold text-brand-dark mb-4 flex items-center gap-2">
              <Icon name="lucide:list-plus" class="w-5 h-5 text-primary" /> Temáticas y Lugares Disponibles
            </h3>
            <p class="text-gray-600 mb-6">
              Consulta la programación detallada, los temas de las charlas y los puntos de encuentro habilitados por la Alcaldía de Medellín en el siguiente enlace:
            </p>
            <a 
              href="https://www.medellin.gov.co/es/eventos/gran-escuela-para-la-familia/" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-primary font-bold hover:underline bg-white px-4 py-2 rounded-lg border border-gray-200 shadow-sm transition-all hover:shadow-md"
            >
              <Icon name="lucide:external-link" class="w-4 h-4" />
              Conoce la programación completa aquí
            </a>
          </div>

          <!-- Botones de Acción -->
          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a 
              href="https://forms.cloud.microsoft/r/kS3xEZRemJ" 
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 inline-flex items-center justify-center gap-3 bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-2xl font-black text-lg transition-all shadow-lg hover:shadow-primary/20 hover:-translate-y-1 active:scale-95"
            >
              <Icon name="lucide:edit-3" class="w-6 h-6" />
              Inscríbete aquí en tu barrio
            </a>
            
            <a 
              href="https://www.instagram.com/reel/DYBD-9HIAbg/" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 text-gray-500 hover:text-primary px-6 py-4 rounded-2xl font-bold transition-colors border border-gray-200 hover:border-primary/20 hover:bg-primary/5"
            >
              <Icon name="lucide:instagram" class="w-5 h-5" />
              Ver en Instagram
            </a>
          </div>

          <div class="text-center py-6 border-t border-gray-100 italic text-brand-dark font-black text-xl">
            ¡Te esperamos para seguir Tejiendo Hogares!
          </div>

          <SocialShare
            title="Gran Escuela para la Familia - IE Capilla del Rosario"
            text="Invitación institucional a madres, padres, acudientes y comunidad educativa para participar en la Gran Escuela para la Familia el sábado 23 de mayo."
            waIcon="lucide:home"
          />
        </div>
      </article>

      <!-- Nueva Publicación: Ingreso a Master2000 -->
      <article
        class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-10 mb-16 relative overflow-hidden"
      >
        <div class="absolute top-0 right-0 p-8 opacity-5">
          <Icon name="lucide:monitor-play" class="w-32 h-32 text-primary" />
        </div>

        <div class="relative z-10">
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-semibold"
            >
              <Icon name="lucide:graduation-cap" class="w-4 h-4" /> Información Académica
            </div>
            <div
              class="inline-flex items-center gap-2 px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-sm font-semibold"
            >
              <Icon name="lucide:calendar" class="w-4 h-4" /> 13 de mayo, 2026
            </div>
          </div>

          <header class="mb-8">
            <h1 class="text-2xl md:text-4xl font-bold text-brand-dark mb-4 leading-tight">
              Ingreso de estudiantes y acudientes a Master2000
            </h1>
            <p class="text-gray-600 text-xl font-medium leading-relaxed max-w-4xl">
              Orientaciones generales para ingresar a la plataforma Master2000, recuperar la contraseña y consultar información académica e institucional.
            </p>
          </header>

          <div class="prose prose-lg max-w-none text-gray-700 mb-12">
            <p>
              Esta publicación reúne las orientaciones generales para el acceso a <strong>Master2000</strong>, la plataforma oficial de nuestra institución para la gestión académica.
            </p>
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-r-lg shadow-sm my-6">
              <div class="flex items-start gap-3">
                <Icon name="lucide:info" class="w-6 h-6 text-blue-600 flex-shrink-0 mt-0.5" />
                <p class="text-blue-800 text-sm">
                  <strong>Nota de apoyo:</strong> Esta información se presenta como guía y algunos pasos pueden depender de la configuración activa de la plataforma en el momento del ingreso.
                </p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
              <!-- Portal y Perfiles -->
              <div class="space-y-8">
                <section>
                  <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
                    <Icon name="lucide:globe" class="w-5 h-5 text-primary" /> 1. Portal de ingreso
                  </h3>
                  <p class="mb-4">El acceso oficial se realiza exclusivamente a través de:</p>
                  <a 
                    href="https://www.master2000.net/web/" 
                    target="_blank" 
                    class="inline-flex items-center gap-2 text-primary font-bold hover:underline bg-primary/5 px-4 py-2 rounded-lg border border-primary/20 transition-colors"
                  >
                    https://www.master2000.net/web/
                    <Icon name="lucide:external-link" class="w-4 h-4" />
                  </a>
                </section>

                <section>
                  <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
                    <Icon name="lucide:users" class="w-5 h-5 text-primary" /> 2. Perfiles de acceso
                  </h3>
                  <p>La plataforma cuenta con accesos diferenciados para:</p>
                  <ul class="list-disc pl-5 mt-2 space-y-1">
                    <li>Estudiante</li>
                    <li>Padre / Madre / Acudiente</li>
                  </ul>
                </section>
              </div>

              <!-- Datos y Primer Ingreso -->
              <div class="space-y-8">
                <section>
                  <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
                    <Icon name="lucide:key-round" class="w-5 h-5 text-primary" /> 3. Datos solicitados
                  </h3>
                  <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                      <Icon name="lucide:user" class="w-5 h-5 text-gray-400 mt-1" />
                      <span><strong>Usuario:</strong> Normalmente es el documento de identidad o el código asignado por la institución.</span>
                    </li>
                    <li class="flex items-start gap-3">
                      <Icon name="lucide:lock" class="w-5 h-5 text-gray-400 mt-1" />
                      <span><strong>Contraseña:</strong> La entregada por el colegio o la que haya sido creada previamente por el usuario.</span>
                    </li>
                  </ul>
                </section>

                <section>
                  <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
                    <Icon name="lucide:sparkles" class="w-5 h-5 text-primary" /> 4. Primer ingreso
                  </h3>
                  <p>Al ingresar por primera vez, el sistema puede solicitar:</p>
                  <ul class="list-disc pl-5 mt-2 space-y-2">
                    <li>Actualización obligatoria de la contraseña.</li>
                    <li>Registro de un correo electrónico válido.</li>
                    <li>Validación o actualización de datos básicos de contacto.</li>
                  </ul>
                </section>
              </div>
            </div>

            <hr class="my-10 border-gray-100" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- Recuperación y Recomendaciones -->
              <div class="space-y-8">
                <section>
                  <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
                    <Icon name="lucide:refresh-cw" class="w-5 h-5 text-primary" /> 5. Recuperación de contraseña
                  </h3>
