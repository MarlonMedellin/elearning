---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import { Icon } from "astro-icon/components";
import SocialShare from "../../components/ui/SocialShare.astro";
---

<MainLayout
  title="Gran Escuela para la Familia"
  description="Invitación institucional a madres, padres, acudientes y comunidad educativa para participar en la Gran Escuela para la Familia el sábado 23 de mayo."
  keywords="Escuela para la Familia, familias, acudientes, crianza, bienestar familiar, IE Capilla del Rosario, Medellín, Tejiendo Hogares"
  image="/assets/escudo.jpg"
>
  <Navbar />
  <PageHeader title="Comunicaciones" />

  <main class="py-12 md:py-20 bg-gray-50/50">
    <div class="container mx-auto px-4 lg:px-8 max-w-4xl">
      <article class="bg-white rounded-3xl shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
        
        <!-- Header / Badge -->
        <div class="relative h-32 md:h-48 bg-brand-dark overflow-hidden">
          <div class="absolute inset-0 opacity-10">
            <Icon name="lucide:users" class="w-64 h-64 -right-10 -bottom-10 absolute text-white" />
          </div>
          <div class="relative h-full flex flex-col justify-center px-6 md:px-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/20 text-primary-light rounded-full text-xs font-bold uppercase tracking-wider mb-3 w-fit backdrop-blur-sm border border-primary/20">
              <Icon name="lucide:home" class="w-3.5 h-3.5" /> Escuela de Familias
            </div>
            <h1 class="text-2xl md:text-4xl font-black text-white leading-tight">
              Gran Escuela para la Familia
            </h1>
          </div>
        </div>

        <div class="p-6 md:p-10">
          <!-- Fecha de publicación -->
          <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-gray-100">
            <div class="flex items-center gap-2 text-gray-500 text-sm font-medium">
              <Icon name="lucide:calendar" class="w-4 h-4" /> 
              Publicado: 14 de mayo, 2026
            </div>
          </div>

          <!-- Introducción -->
          <div class="prose prose-lg max-w-none text-gray-700 mb-10">
            <p class="text-xl font-medium text-gray-600 leading-relaxed">
              La IE Capilla del Rosario MDE invita cordialmente a madres, padres, acudientes y familias a participar en la <strong>Gran Escuela para la Familia</strong>, un espacio de encuentro y formación orientado al fortalecimiento de la crianza, el bienestar familiar y las relaciones en casa.
            </p>
          </div>

          <!-- Bloque Destacado de Información -->
          <div class="bg-brand-light/10 border border-brand-light/30 rounded-2xl p-6 md:p-8 mb-10">
            <h2 class="text-lg font-bold text-brand-dark mb-6 flex items-center gap-2 uppercase tracking-wide">
              <Icon name="lucide:info" class="w-5 h-5 text-primary" /> Detalles del encuentro
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-primary shrink-0">
                  <Icon name="lucide:calendar-check" class="w-6 h-6" />
                </div>
                <div>
                  <span class="block text-xs font-bold text-gray-400 uppercase">Fecha</span>
                  <span class="text-lg font-bold text-brand-dark">Sábado 23 de mayo, 2026</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-primary shrink-0">
                  <Icon name="lucide:clock" class="w-6 h-6" />
                </div>
                <div>
                  <span class="block text-xs font-bold text-gray-400 uppercase">Hora</span>
                  <span class="text-lg font-bold text-brand-dark">10:00 a.m. – 12:00 m.</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-primary shrink-0">
                  <Icon name="lucide:map-pin" class="w-6 h-6" />
                </div>
                <div>
                  <span class="block text-xs font-bold text-gray-400 uppercase">Lugar</span>
                  <span class="text-lg font-bold text-brand-dark">En tu comuna y corregimiento</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-white shadow-sm flex items-center justify-center text-primary shrink-0">
                  <Icon name="lucide:users-2" class="w-6 h-6" />
                </div>
                <div>
                  <span class="block text-xs font-bold text-gray-400 uppercase">Público invitado</span>
                  <span class="text-lg font-bold text-brand-dark">Madres, padres, acudientes y comunidad educativa</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Propósito -->
          <div class="prose prose-lg max-w-none text-gray-700 mb-12">
            <h3 class="text-xl font-bold text-brand-dark mb-4">Propósito del espacio</h3>
            <p>
              Este encuentro busca promover conversaciones cercanas, aprendizajes útiles para la vida diaria y herramientas que ayuden a fortalecer los vínculos familiares, la crianza amorosa y el bienestar en el hogar.
            </p>
            <p class="text-sm italic text-gray-500 bg-gray-50 p-4 rounded-lg border-l-4 border-primary mt-6">
              <strong>Nota:</strong> Para participar es indispensable realizar la inscripción previa mediante el formulario oficial.
            </p>
          </div>

          <!-- Botones de Acción -->
          <div class="flex flex-col gap-4 mb-12">
            <a 
              href="https://forms.cloud.microsoft/r/kS3xEZRemJ" 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-3 bg-primary hover:bg-primary/90 text-white px-8 py-5 rounded-2xl font-black text-lg transition-all shadow-lg hover:shadow-primary/20 hover:-translate-y-1 active:scale-95"
            >
              <Icon name="lucide:edit-3" class="w-6 h-6" />
              Inscríbete y participa
            </a>
            
            <a 
              href="https://www.instagram.com/reel/DYBD-9HIAbg/" 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 text-gray-500 hover:text-primary px-6 py-3 rounded-xl font-bold transition-colors border border-transparent hover:border-primary/20 hover:bg-primary/5"
            >
              <Icon name="lucide:instagram" class="w-5 h-5" />
              Ver publicación de referencia en Instagram
            </a>
          </div>

          <!-- Cierre -->
          <div class="text-center py-8 border-t border-gray-100">
            <p class="text-lg font-medium text-brand-dark italic">
              “Los esperamos para seguir fortalecer juntos los vínculos familiares y el acompañamiento a nuestros estudiantes.”
            </p>
          </div>

          <!-- Social Share -->
          <div class="mt-8 pt-8 border-t border-gray-100">
            <SocialShare
              title="Gran Escuela para la Familia - IE Capilla del Rosario"
              text="Participa en este espacio de encuentro para fortalecer la crianza, el bienestar y las relaciones en casa. ¡Inscríbete ahora!"
              waIcon="lucide:home"
            />
          </div>
        </div>

        <!-- Espacio para Galería Futura -->
        <div class="hidden bg-gray-50 p-6 md:p-10 border-t border-gray-100">
           <h3 class="text-lg font-bold text-brand-dark mb-6 flex items-center gap-2">
            <Icon name="lucide:camera" class="w-5 h-5 text-primary" /> 
            Galería de la jornada
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {/* Espacio reservado para imágenes futuras */}
          </div>
        </div>

      </article>

      <!-- Botón de retorno -->
      <div class="mt-10 text-center">
        <a href="/circulares" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary font-bold transition-colors group">
          <Icon name="lucide:arrow-left" class="w-5 h-5 transition-transform group-hover:-translate-x-1" />
          Volver a Comunicaciones
        </a>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
